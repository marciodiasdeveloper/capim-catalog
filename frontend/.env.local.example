# Supabase — copie para .env.local e preencha com as chaves do seu projeto
# (Project Settings → API)

# Públicas (expostas ao browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Secreta — usada APENAS no servidor (Server Actions) e no script de seed.
# Ignora RLS, então NUNCA commitar nem expor ao browser.
SUPABASE_SERVICE_ROLE_KEY=

# E-mails com acesso ao /admin (separados por vírgula). Esses usuários precisam
# existir em Auth → Users no Supabase. Sem isso, ninguém entra no admin.
ADMIN_EMAILS=web@knowu.com.br
