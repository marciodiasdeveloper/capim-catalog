{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(npm run dev:*)",
      "Bash(npm run build:*)",
      "Bash(npm run lint:*)",
      "Bash(npm run seed:*)",
      "Bash(npx tsc:*)",
      "Bash(npx eslint:*)",
      "Bash(npx next:*)",
      "Bash(curl:*)",
      "Bash(node -e:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(./.env*)",
      "Bash(rm -rf:*)"
    ]
  }
}
