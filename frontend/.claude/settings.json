{
  "$schema": "https://json.schemastore.org/claude-code-settings.json",
  "permissions": {
    "allow": [
      "Bash(pnpm install:*)",
      "Bash(pnpm dev:*)",
      "Bash(pnpm build:*)",
      "Bash(pnpm lint:*)",
      "Bash(pnpm seed:*)",
      "Bash(pnpm exec tsc:*)",
      "Bash(pnpm exec eslint:*)",
      "Bash(pnpm exec next:*)",
      "Bash(pnpm dlx:*)",
      "Bash(curl:*)",
      "Bash(node -e:*)"
    ],
    "deny": [
      "Read(.env*)",
      "Read(./.env*)",
      "Bash(rm -rf:*)"
    ]
  }
}
